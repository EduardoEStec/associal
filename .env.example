# ASSOCIAL — copie para ".env" e ajuste. NUNCA versione o .env.

# --- Aplicação ---
PORT=3000
# Gere um segredo longo e aleatório:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Pasta das fotos enviadas (no Docker já é /app/uploads, volume persistente)
UPLOAD_DIR=uploads

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=ASSOCIAL
# Azure SQL / servidores com TLS válido: DB_ENCRYPT=true. SQL Server local/autoassinado: DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Primeiro acesso (usado só por "npm run db:migrate") ---
# Senha inicial do usuário "admin" (mín. 8 caracteres). Se vazio, uma senha aleatória é gerada e impressa uma vez.
# A troca é exigida no primeiro login.
ADMIN_SENHA_INICIAL=

# --- Opcionais ---
# Atrás de HTTPS / proxy reverso: COOKIE_SECURE=true e TRUST_PROXY=1
COOKIE_SECURE=false
TRUST_PROXY=
# Duração da sessão (horas)
SESSION_HORAS=12
# 'sql' (padrão, tabela sessao) ou 'memoria' (só para testes sem banco)
SESSION_STORE=sql
# Senha do SA do SQL Server de teste (docker-compose.dev.yml)
DEV_SA_PASSWORD=Associal#Dev2026
